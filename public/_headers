/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless
  Strict-Transport-Security: max-age=31536000
  Cache-Control: public, max-age=60, stale-while-revalidate=600
  Speculation-Rules: "/speculation.json"
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' data:; connect-src 'self' blob: data:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

# Only the two tools that download a large model may reach those hosts. The worker holding files never can.
/remove-background
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' data:; connect-src 'self' blob: data: https://cdn.jsdelivr.net https://huggingface.co https://*.huggingface.co https://*.hf.co; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

/upscale-image
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' data:; connect-src 'self' blob: data: https://cdn.jsdelivr.net https://huggingface.co https://*.huggingface.co https://*.hf.co; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

# Hashed build output never changes.
/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Engine names do not change between releases, so browsers must revalidate them.
/vendor/*
  ! Cache-Control
  Cache-Control: no-cache

# The service worker must always be checked, or a bad release could never be replaced.
/sw.js
  ! Cache-Control
  Cache-Control: no-cache

/*.md
  ! Content-Type
  Content-Type: text/markdown; charset=utf-8

/speculation.json
  ! Cache-Control
  Content-Type: application/speculationrules+json
  Cache-Control: public, max-age=3600
