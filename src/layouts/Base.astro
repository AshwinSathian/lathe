---
import "../styles/global.css";
import font from "../fonts/bricolage-grotesque.woff2?url";
interface Props { title: string; description: string; jsonld?: object[]; }
const { title, description, jsonld = [] } = Astro.props;
const url = new URL(Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "/"), Astro.site).href;
const og = new URL("/og.png", Astro.site).href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={url} />
  <link rel="preload" href={font} as="font" type="font/woff2" crossorigin />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/icon-180.png" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM summary" />
  <meta name="theme-color" media="(prefers-color-scheme: light)" content="#e8ecf1" />
  <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#101b30" />
  <meta property="og:type" content="website" /><meta property="og:site_name" content="Lathe" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={url} /><meta property="og:image" content={og} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:image" content={og} />
  {jsonld.map((x) => <script is:inline type="application/ld+json" set:html={JSON.stringify(x).replace(/</g, "\\u003c")} />)}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="wrap bar">
    <a class="brand" href="/" aria-label="Lathe home"><svg viewBox="0 0 32 32" aria-hidden="true"><defs><linearGradient id="bm" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#5d6f8f"/><stop offset=".32" stop-color="#f4f7fb"/><stop offset=".6" stop-color="#8496b4"/><stop offset="1" stop-color="#1c2f52"/></linearGradient></defs><rect width="32" height="32" rx="7" fill="#12203a"/><path d="M4 11h6l2-3h8l2 3h6v10h-6l-2 3h-8l-2-3H4z" fill="url(#bm)"/><path d="M12 8v16M20 8v16" stroke="#c99a45" stroke-width="1.5"/></svg>Lathe</a>
    <nav aria-label="Main">
      <a href="/#images">Images</a><a href="/#pdf">PDF</a><a href="/privacy">Privacy</a>
      <button class="find" type="button" data-palette><span>Find a tool</span><kbd>⌘K</kbd></button>
    </nav>
  </header>
  <main id="main"><slot /></main>
  <footer class="foot"><div class="wrap"><span>Lathe works on your device. Your files are never uploaded.</span><span><a href="/privacy">How privacy works here</a></span></div></footer>
  <dialog class="palette" aria-label="Find a tool"><input type="search" placeholder="Find a tool, like heic to jpg" aria-label="Find a tool" role="combobox" aria-expanded="true" aria-controls="palette-list" autocomplete="off" /><ul id="palette-list" role="listbox"></ul></dialog>
  <script>import "../app/shell";</script>
</body>
</html>
